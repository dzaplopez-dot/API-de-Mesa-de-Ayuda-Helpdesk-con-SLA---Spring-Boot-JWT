{
  "info": {
    "name": "API de Mesa de Ayuda (Helpdesk) con SLA",
    "description": "API REST para gestión de tickets de soporte técnico con autenticación JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registro de usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"email\": \"juan@mail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/registro",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "registro"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Renovar Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/ping",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "ping"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Tickets",
      "item": [
        {
          "name": "Crear ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Problema con la impresora\",\n  \"descripcion\": \"La impresora no imprime documentos\",\n  \"prioridad\": \"MEDIA\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/tickets",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Listar mis tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/tickets/mios",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets", "mios"]
            }
          }
        },
        {
          "name": "Obtener ticket por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/tickets/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets", "1"]
            }
          }
        },
        {
          "name": "Listar todos los tickets (SOPORTE/ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/tickets",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Cambiar estado de ticket (SOPORTE/ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PROCESO\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/tickets/1/estado",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets", "1", "estado"]
            }
          }
        },
        {
          "name": "Listar tickets vencidos (SOPORTE/ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/tickets/vencidos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tickets", "vencidos"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Administración (ADMIN)",
      "item": [
        {
          "name": "Ascender usuario a SOPORTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/soporte?email=juan@mail.com",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "admin", "soporte"],
              "query": [
                {
                  "key": "email",
                  "value": "juan@mail.com"
                }
              ]
            }
          }
        },
        {
          "name": "Listar todos los usuarios (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/usuarios",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "admin", "usuarios"]
            }
          }
        },
        {
          "name": "Obtener usuario por email (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/admin/usuario?email=juan@mail.com",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "admin", "usuario"],
              "query": [
                {
                  "key": "email",
                  "value": "juan@mail.com"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ]
}
